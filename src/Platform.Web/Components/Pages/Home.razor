@* صفحهٔ خانهٔ پایه: خوش‌آمد + میان‌بر بخش‌ها. پروژهٔ میزبان می‌تواند صفحهٔ خودش را جایگزین کند. *@
@page "/"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
<PageTitle>خانه</PageTitle>

<div class="mb-3">
    <h3 class="mb-1">به سامانه خوش آمدید</h3>
    <div class="text-body-secondary small">از منوی کنار، بخش موردنظر را انتخاب کنید.</div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <a href="notifications" class="card-panel d-block text-decoration-none">
            <i class="bi bi-bell fs-4"></i>
            <div class="fw-semibold mt-2">اعلان‌ها</div>
            <div class="text-body-secondary small">آرشیو اعلان‌های شما</div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="sessions" class="card-panel d-block text-decoration-none">
            <i class="bi bi-phone fs-4"></i>
            <div class="fw-semibold mt-2">نشست‌های فعال</div>
            <div class="text-body-secondary small">توکن‌ها و ورودهای اخیر</div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="profile" class="card-panel d-block text-decoration-none">
            <i class="bi bi-person fs-4"></i>
            <div class="fw-semibold mt-2">پروفایل</div>
            <div class="text-body-secondary small">مشخصات و رمز عبور</div>
        </a>
    </div>
</div>
