@page "/admin/roles"
@rendermode InteractiveServer
@attribute [Authorize(Roles = Platform.Domain.Identity.Roles.Admin)]
@using Microsoft.AspNetCore.Authorization
@using Platform.Application.Services
@using Platform.Domain.Identity
@inject IPermissionService PermissionService
@inject IUserAdminService UserAdminService
@inject ILogger<Platform.Web.Components.Pages.Admin.RolePermissions> Logger

<PageTitle>مدیریت مجوز نقش‌ها</PageTitle>

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">مدیریت مجوز نقش‌ها</h3>
        <div class="text-body-secondary small">تعیین دسترسی هر نقش به بخش‌های مختلف برنامه</div>
    </div>
</div>

@if (Success)
{
    <div class="alert alert-success">مجوزهای نقش ذخیره شد.</div>
}
@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="card-panel">
    <div class="mb-4">
        <label class="form-label">انتخاب نقش</label>
        <select class="form-select" style="max-width: 300px;" @bind="selectedRole" @bind:after="LoadPermissions">
            @foreach (var role in roles)
            {
                <option value="@role.Name">@role.PersianName</option>
            }
        </select>
    </div>

    @if (selectedRole is not null)
    {
        <div class="mb-4">
            <label class="form-label">مجوزهای این نقش</label>
            @if (states.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    هنوز هیچ مجوزی تعریف نشده است. پروژهٔ شما باید یک
                    <code>IPermissionCatalog</code> در DI ثبت کند.
                </div>
            }
            @foreach (var state in states)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="@("perm_" + state.Permission.Key)"
                           checked="@state.IsGranted"
                           @onchange="@(e => TogglePermission(state.Permission.Key, (bool)e.Value!))" />
                    <label class="form-check-label" for="@("perm_" + state.Permission.Key)">
                        @state.Permission.Title
                        <span class="text-body-secondary small">(@state.Permission.Key)</span>
                    </label>
                </div>
            }
        </div>

        <button class="btn btn-primary" @onclick="Save" disabled="@isSaving">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
            }
            ذخیره
        </button>
        <p class="text-body-secondary mt-3" style="font-size: 0.85rem;">
            توجه: کاربرانی که از قبل وارد شده‌اند باید یک‌بار خارج و دوباره وارد شوند تا تغییرات مجوز روی آن‌ها اعمال شود.
        </p>
    }
</div>

@code {
    private string? selectedRole = Platform.Domain.Identity.Roles.Admin;
    private List<RoleDto> roles = new();
    private IReadOnlyList<PermissionStateDto> states = [];
    private readonly HashSet<string> currentPermissions = new(StringComparer.Ordinal);
    private bool Success;
    private string? errorMessage;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        roles = await UserAdminService.GetAllRolesAsync();
        await LoadPermissions();
    }

    private async Task LoadPermissions()
    {
        Success = false;
        errorMessage = null;
        if (selectedRole is null) return;

        states = await PermissionService.GetPermissionStatesAsync(selectedRole);

        currentPermissions.Clear();
        foreach (var state in states.Where(s => s.IsGranted))
        {
            currentPermissions.Add(state.Permission.Key);
        }
    }

    private void TogglePermission(string permission, bool isChecked)
    {
        if (isChecked) currentPermissions.Add(permission);
        else currentPermissions.Remove(permission);
    }

    private async Task Save()
    {
        errorMessage = null;
        Success = false;
        isSaving = true;
        try
        {
            if (selectedRole is not null)
            {
                var result = await PermissionService.SetPermissionsForRoleAsync(
                    selectedRole, currentPermissions.ToList());
                if (result.Succeeded)
                    Success = true;
                else
                    errorMessage = string.Join(" | ", result.Errors.Select(e => e.Description));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "خطا در ذخیره مجوزهای نقش {RoleName}", selectedRole);
            errorMessage = Platform.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex);
        }
        finally
        {
            isSaving = false;
        }
    }
}