root = true

# فایل‌های متنی (کد و تنظیمات) همیشه UTF-8 بدون BOM با پایان خط CRLF در ویندوز
[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# فایل‌های JSON/YAML با تورفتگی دو فاصله
[*.{json,yml,yaml,webmanifest}]
indent_size = 2

# فایل‌هایی که هرگز نباید راست‌چین/دستکاری شوند
[*.{ttf,woff,woff2,png,ico}]
end_of_line = unset
indent_style = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[*.cs]
indent_size = 4
csharp_new_line_before_open_brace = all
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
csharp_style_namespace_declarations = file_scoped:warning

[*.razor]
indent_size = 4

# فایل‌های تولیدشده
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
