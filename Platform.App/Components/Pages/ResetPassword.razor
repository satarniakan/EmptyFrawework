@page "/reset-password"
@attribute [ExcludeFromInteractiveRouting]

<PageTitle>فراموشی رمز عبور</PageTitle>

<div class="d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="card-panel" style="width: 100%; max-width: 420px;">

        @if (string.IsNullOrEmpty(Phone))
        {
            @* مرحلهٔ ۱: شماره موبایل *@
            <h3 class="text-center mb-2">فراموشی / تعیین رمز عبور</h3>
            <p class="text-center text-muted mb-4" style="font-size: 0.9rem;">
                شماره موبایل خود را وارد کنید تا کد تأیید برایتان پیامک شود.
                اگر تا کنون رمزی نداشتید (مثلاً با ایمپورت اکسل اضافه شده‌اید)، همین مسیر رمز اولیه برایتان می‌سازد.
            </p>

            @if (Error == "captcha")
            {
                <div class="alert alert-danger">اعتبارسنجی امنیتی ناموفق بود؛ دوباره تلاش کنید.</div>
            }
            else if (!string.IsNullOrEmpty(Error))
            {
                <div class="alert alert-danger">@Error</div>
            }

            <form method="post" action="/Account/RequestPasswordReset" data-enhance="false">
                <AntiforgeryToken />

                <div class="mb-4">
                    <label class="form-label">شماره موبایل</label>
                    <input type="tel" name="phoneNumber" class="form-control" placeholder="09xxxxxxxxx" required pattern="09[0-9]{9}" />
                </div>

                @if (!string.IsNullOrWhiteSpace(turnstileSiteKey))
                {
                    <div class="mb-4">
                        <div class="cf-turnstile" data-sitekey="@turnstileSiteKey" data-language="fa"></div>
                    </div>
                    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
                }

                <button type="submit" class="btn btn-primary w-100">ارسال کد تأیید</button>
            </form>
        }
        else
        {
            @* مرحلهٔ ۲: کد پیامکی + رمز جدید *@
            <h3 class="text-center mb-2">تعیین رمز جدید</h3>
            <p class="text-center text-muted mb-4" style="font-size: 0.9rem;">
                کد ۶ رقمی ارسال‌شده به شماره <strong>@Phone</strong> را همراه رمز جدید وارد کنید.
            </p>

            @switch (Error)
            {
                case "otp":
                    <div class="alert alert-danger">کد وارد‌شده صحیح نیست یا منقضی شده است.</div>
                    break;
                case "user":
                    <div class="alert alert-danger">این شماره در سامانه ثبت نشده است.</div>
                    break;
                case "mismatch":
                    <div class="alert alert-warning">رمز جدید و تکرار آن یکسان نیستند.</div>
                    break;
                case "failed":
                    <div class="alert alert-danger">تعیین رمز ناموفق بود؛ رمز را قوی‌تر انتخاب کنید (حداقل ۶ کاراکتر).</div>
                    break;
            }

            <form method="post" action="/Account/ResetPassword" data-enhance="false">
                <AntiforgeryToken />
                <input type="hidden" name="phoneNumber" value="@Phone" />

                <div class="mb-3">
                    <label class="form-label">کد تأیید</label>
                    <input type="text" name="code" class="form-control text-center" maxlength="6" pattern="[0-9]{6}" required style="letter-spacing: 0.3rem; font-size: 1.2rem;" />
                </div>

                <div class="mb-3">
                    <label class="form-label">رمز عبور جدید</label>
                    <input type="password" name="newPassword" class="form-control" minlength="6" required />
                </div>

                <div class="mb-4">
                    <label class="form-label">تکرار رمز عبور</label>
                    <input type="password" name="confirmPassword" class="form-control" minlength="6" required />
                </div>

                <button type="submit" class="btn btn-primary w-100">تعیین رمز و ورود</button>
            </form>

            <p class="text-center text-muted mt-3 mb-0" style="font-size: 0.9rem;">
                <a href="/reset-password">تغییر شماره موبایل / ارسال دوباره کد</a>
            </p>
        }

        <p class="text-center text-muted mt-3 mb-0" style="font-size: 0.9rem;">
            <a href="/login">بازگشت به ورود</a>
        </p>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "phone")]
    private string? Phone { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    [Inject] private IConfiguration Configuration { get; set; } = default!;
    [Inject] private Platform.Application.Services.ISettingService Settings { get; set; } = default!;

    private string? turnstileSiteKey;

    protected override async Task OnInitializedAsync()
    {
        // فقط در مرحلهٔ ۱ کپچا لازم است؛ کلید از تنظیم یکپارچه‌سازی (یا appsettings).
        turnstileSiteKey = await Settings.GetEffectiveAsync(
            Platform.Domain.Identity.IntegrationSettingKeys.TurnstileSiteKey,
            "Captcha:Turnstile:SiteKey");
        if (string.IsNullOrWhiteSpace(turnstileSiteKey))
            turnstileSiteKey = null;
    }
}
