{
  "$schema": "https://json.schemastore.org/appsettings.json",

  "//": "این فایل را به appsettings.json کپی کنید و مقادیر واقعی را بگذارید. خودِ appsettings.json عمداً در git نیست.",

  "ConnectionStrings": {
    "Default": "Server=(localdb)\\mssqllocaldb;Database=EmptyFrameworkDev;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Identity": {
    "//": "شماره‌ی ادمین اول روی دیتابیس خالی. خالی یعنی هیچ‌کس خودکار ادمین نمی‌شود و کاربران تازه نقش «کاربر» می‌گیرند.",
    "FirstAdminPhoneNumber": ""
  },
  "Sms": {
    "//": "Provider: Fake (لاگ) یا Kavenegar (واقعی).",
    "Provider": "Fake",
    "Kavenegar": {
      "ApiKey": "",
      "Sender": null
    },
    "MaxAttempts": 3,
    "BatchSize": 20
  },
  "Email": {
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": null,
      "Password": null,
      "FromAddress": "no-reply@localhost",
      "FromName": "سامانه"
    }
  },
  "Payment": {
    "//": "Provider: Fake (نمایشی) یا ZarinPal (واقعی). مبالغ به تومان.",
    "Provider": "Fake",
    "ZarinPal": {
      "MerchantId": "",
      "Sandbox": false
    }
  },
  "Captcha": {
    "//": "Provider: خالی/Fake (غیرفعال) یا Turnstile (واقعی).",
    "Provider": "",
    "Turnstile": {
      "SiteKey": "",
      "SecretKey": ""
    }
  },
  "Push": {
    "//": "کلیدهای VAPID برای وب‌پوش. ساخت: npx web-push generate-vapid-keys",
    "//Subject": "mailto:admin@example.com",
    "Vapid": {
      "Subject": "",
      "PublicKey": "",
      "PrivateKey": ""
    }
  },
  "ApiTokens": {
    "//": "عمر توکن موبایل به روز.",
    "LifetimeDays": 180
  },
  "ForwardedHeaders": {
    "//": "پشت reverse proxy این را false نگه دارید، وگرنه همهٔ کاربران یک IP می‌گیرند و rate limit همه را قفل می‌کند.",
    "TrustAllProxies": false
  },
  "AllowedHosts": "*",
  "Storage": {
    "//": "فعال‌سازی LocalFileStorage (لایه‌ی Infrastructure/Services) در محیط‌های Local/Development استفاده می‌شود؛ مقدار‌های خالی برای LocalFileStorage در محیط‌های واقعی قابل تنظیم است.",
    "RootPath": "AppData",
    "MaxFileSizeBytes": "52428800",
    "AllowedExtensions": "jpg,jpeg,png,gif,bmp,webp,mp3,mp4,pdf,docx,xlsx,pptx,zip"
  }
}
