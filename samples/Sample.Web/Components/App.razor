@using Microsoft.AspNetCore.Components.Endpoints
@using Platform.Web.Components
@using Sample.Web.Components
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <script src="_content/Platform.Web/theme.js"></script>

    <link rel="stylesheet" href="_content/Platform.Web/fonts/vazirmatn.css">
    <link rel="stylesheet" href="_content/Platform.Web/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="_content/Platform.Web/lib/bootstrap-icons/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="_content/Platform.Web/app.css" />

    <link rel="stylesheet" href="_content/Platform.Web/lib/datepicker/datepicker.min.css">
    <script src="_content/Platform.Web/lib/datepicker/datepicker.min.js"></script>
    <script src="_content/Platform.Web/persian-datepicker-interop.js"></script>
    <script src="_content/Platform.Web/priceInput.js"></script>

    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>
<body>
    <Routes AdditionalAssemblies="SampleRoutes.AdditionalAssemblies" @rendermode="RenderModeForPage" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // صفحاتی که [ExcludeFromInteractiveRouting] دارند (مثل Login و VerifyOtp) به HttpContext
    // نیاز دارند تا AntiforgeryToken و فرم‌های POST کار کنند. برای آن‌ها رندرمود را null
    // می‌گذاریم تا کاملاً استاتیک رندر شوند؛ بقیه صفحات تعاملی باقی می‌مانند.
    private IComponentRenderMode? RenderModeForPage =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}