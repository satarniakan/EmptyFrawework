@* samples/Sample.Web/Components/Shared/MeetingCalendar.razor *@
@* تقویم شمسی ماهانه با علامت‌گذاری جلسات — الگوی نمای ماه Outlook:
   ستون‌ها شنبه تا جمعه، عدد شمسی بزرگ + عدد میلادی کوچک، بلوک جلسات روی روزها. *@
@using System.Globalization
@using Platform.Application.Helpers

<div class="meeting-calendar card-panel mb-3">
    <div class="cal-header d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
        <div class="d-flex align-items-center gap-1">
            <button class="btn btn-sm btn-outline-secondary cal-nav" @onclick="PrevMonth" title="ماه قبل" aria-label="ماه قبل">
                <i class="bi bi-chevron-right"></i>
            </button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="GoToday">امروز</button>
            <button class="btn btn-sm btn-outline-secondary cal-nav" @onclick="NextMonth" title="ماه بعد" aria-label="ماه بعد">
                <i class="bi bi-chevron-left"></i>
            </button>
        </div>
        <h5 class="mb-0">@Title</h5>
    </div>

    <div class="cal-grid cal-weekdays">
        @foreach (var w in WeekdayNames)
        {
            <div class="cal-weekday">@w</div>
        }
    </div>

    <div class="cal-grid">
        @foreach (var cell in Cells)
        {
            <div class="cal-cell @(cell.IsCurrentMonth ? "" : "cal-other-month") @(cell.IsToday ? "cal-today" : "")">
                <div class="cal-date">
                    <span class="cal-day-jalali">@Fa(cell.JalaliDay.ToString())</span>
                    @if (cell.GregorianDate.Day == 1)
                    {
                        <span class="cal-gregorian-label">@cell.GregorianDate.ToString("MMM d", CultureInfo.InvariantCulture)</span>
                    }
                    else
                    {
                        <span class="cal-day-gregorian">@cell.GregorianDate.Day</span>
                    }
                </div>

                @foreach (var m in cell.Meetings)
                {
                    <a href="/my-meetings/@m.Id"
                       class="cal-meeting @(m.Kind == MeetingKind.InPerson ? "cal-inperson" : "cal-virtual")"
                       title="@m.Title — @(m.Kind == MeetingKind.InPerson ? m.Location : m.MeetingLink)">
                        <span class="cal-meeting-time">@Fa(PersianDateHelper.ToTehran(m.StartAt).ToString("HH:mm"))</span>
                        <span class="cal-meeting-title">@m.Title</span>
                    </a>
                }
            </div>
        }
    </div>

    <div class="cal-legend small text-body-secondary mt-2">
        <span class="cal-legend-item"><span class="cal-dot cal-inperson"></span>حضوری</span>
        <span class="cal-legend-item"><span class="cal-dot cal-virtual"></span>غیرحضوری</span>
    </div>
</div>

@code {
    /// <summary>جلساتی که باید روی تقویم علامت بخورند.</summary>
    [Parameter] public List<Meeting> Meetings { get; set; } = [];

    private static readonly PersianCalendar Pc = new();
    private static readonly string[] WeekdayNames =
        ["شنبه", "یکشنبه", "دوشنبه", "سه‌شنبه", "چهارشنبه", "پنجشنبه", "جمعه"];

    private int year;   // سال شمسی
    private int month;  // ماه شمسی
    private List<CalCell> Cells = [];

    private string Title => $"{PersianMonthName(month)} {Fa(year.ToString())}";

    protected override void OnInitialized() => GoToday();

    /// <summary>
    /// پارامتر Meetings بعد از اولین رندر (وقتی OnInitializedAsync والد تمام می‌شود)
    /// می‌رسد؛ سلول‌ها باید با دادهٔ تازه دوباره ساخته شوند وگرنه تقویم خالی می‌ماند.
    /// </summary>
    protected override void OnParametersSet() => Build();

    private void PrevMonth()
    {
        month--;
        if (month == 0) { month = 12; year--; }
        Build();
    }

    private void NextMonth()
    {
        month++;
        if (month == 13) { month = 1; year++; }
        Build();
    }

    private void GoToday()
    {
        var tehran = PersianDateHelper.ToTehran(DateTime.UtcNow);
        year = Pc.GetYear(tehran);
        month = Pc.GetMonth(tehran);
        Build();
    }

    private void Build()
    {
        var today = PersianDateHelper.ToTehran(DateTime.UtcNow).Date;

        // روز اول ماه شمسی به میلادی؛ هفتهٔ شمسی از شنبه شروع می‌شود
        var firstOfMonth = Pc.ToDateTime(year, month, 1, 0, 0, 0, 0);
        var lead = (((int)firstOfMonth.DayOfWeek + 1) % 7 + 7) % 7; // Saturday=0
        var gridStart = firstOfMonth.AddDays(-lead);

        var byDay = Meetings
            .GroupBy(m => PersianDateHelper.ToTehran(m.StartAt).Date)
            .ToDictionary(g => g.Key, g => g.OrderBy(m => m.StartAt).ToList());

        Cells = new List<CalCell>(42);
        for (var i = 0; i < 42; i++)
        {
            var date = gridStart.AddDays(i);
            Cells.Add(new CalCell
            {
                GregorianDate = date,
                JalaliDay = Pc.GetDayOfMonth(date),
                IsCurrentMonth = Pc.GetMonth(date) == month,
                IsToday = date == today,
                Meetings = byDay.TryGetValue(date, out var list) ? list : []
            });
        }

        // ردیف ششم اگر کاملاً به ماه بعد تعلق داشت حذف می‌شود
        while (Cells.Count > 35 && Cells.TakeLast(7).All(c => !c.IsCurrentMonth))
        {
            Cells.RemoveRange(35, 7);
        }
    }

    private static string PersianMonthName(int m) => m switch
    {
        1 => "فروردین", 2 => "اردیبهشت", 3 => "خرداد", 4 => "تیر",
        5 => "مرداد", 6 => "شهریور", 7 => "مهر", 8 => "آبان",
        9 => "آذر", 10 => "دی", 11 => "بهمن", 12 => "اسفند",
        _ => string.Empty
    };

    /// <summary>تبدیل ارقام لاتین به فارسی (نسخهٔ سبک برای همین کامپوننت).</summary>
    private static string Fa(string s) =>
        string.Concat(s.Select(c => char.IsDigit(c) ? (char)('۰' + (c - '0')) : c));

    private sealed class CalCell
    {
        public DateTime GregorianDate { get; set; }
        public int JalaliDay { get; set; }
        public bool IsCurrentMonth { get; set; }
        public bool IsToday { get; set; }
        public List<Meeting> Meetings { get; set; } = [];
    }
}
