@page "/meetings/{Id:int}/manage"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Meetings.MeetingPermissions.Manage)]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using System.Security.Claims
@using Platform.Domain.Interfaces
@inherits Platform.Web.Components.Shared.AppComponentBase
@inject IMeetingService MeetingService
@inject IFileStorage FileStorage
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
<PageTitle>مدیریت جلسه</PageTitle>

@if (meeting is null && loadFailed)
{
    <div class="alert alert-danger">جلسه یافت نشد.</div>
}
else if (meeting is null)
{
    <LoadingSkeleton Table="false" Rows="8" />
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h3 class="mb-1">@meeting.Title</h3>
            <div class="text-body-secondary small">
                <i class="bi bi-calendar3 me-1"></i>@meeting.StartAt.ToPersianDateTime()
                @if (meeting.Kind == MeetingKind.InPerson)
                {
                    <span class="ms-3"><i class="bi bi-geo-alt me-1"></i>حضوری — @meeting.Location</span>
                }
                else
                {
                    <span class="ms-3"><i class="bi bi-camera-video me-1"></i>غیرحضوری — <a href="@meeting.MeetingLink" target="_blank" rel="noopener">لینک جلسه</a></span>
                }
            </div>
        </div>
        <a href="/meetings" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-right me-1"></i>بازگشت به فهرست
        </a>
    </div>

    @* ===== پیشنهادهای زمان ===== *@
    @if (proposals is { Count: > 0 })
    {
        <div class="card-panel mb-3 border-warning">
            <h6 class="form-section-title"><i class="bi bi-hourglass-split"></i>پیشنهادهای زمان جدید</h6>
            @foreach (var p in proposals)
            {
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 py-2 border-bottom">
                    <div>
                        <span class="fw-semibold">@p.ProposerName</span>
                        <span class="mx-1">زمان</span>
                        <span class="fw-semibold">@p.ProposedStartAt.ToPersianDateTime()</span>
                        را پیشنهاد داد.
                        @if (!string.IsNullOrWhiteSpace(p.Note))
                        {
                            <div class="small text-body-secondary">«@p.Note»</div>
                        }
                    </div>
                    <div>
                        @if (p.Status == ProposalStatus.Pending)
                        {
                            <button class="btn btn-sm btn-success" @onclick="@(async () => await DecideAsync(p.Id, true))">
                                <i class="bi bi-check-lg me-1"></i>پذیرش و جابه‌جایی جلسه
                            </button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="@(async () => await DecideAsync(p.Id, false))">رد</button>
                        }
                        else if (p.Status == ProposalStatus.Accepted)
                        {
                            <span class="badge text-bg-success">پذیرفته شد</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">رد شد</span>
                        }
                    </div>
                </div>
            }
            <div class="form-text mt-2">با پذیرش یک پیشنهاد، زمان جلسه تغییر می‌کند و پاسخ قبلی همهٔ مدعوین به «در انتظار» برمی‌گردد.</div>
        </div>
    }

    @* ===== مدعوین و حضور و غیاب ===== *@
    <div class="card-panel mb-3">
        <h6 class="form-section-title"><i class="bi bi-people"></i>مدعوین و حضور و غیاب</h6>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>نام</th>
                        <th>تلفن</th>
                        <th>پاسخ به دعوت</th>
                        <th>حضور</th>
                    </tr>
                </thead>
                <tbody>
                    @if (invitees is null)
                    {
                        <tr><td colspan="4"><LoadingSkeleton Table="false" Rows="3" /></td></tr>
                    }
                    else
                    {
                        @foreach (var i in invitees)
                        {
                            <tr>
                                <td class="fw-semibold">@i.FullName</td>
                                <td>@i.PhoneNumber</td>
                                <td>
                                    @switch (i.Response)
                                    {
                                        case InviteResponse.Accepted:
                                            <span class="badge text-bg-success">پذیرفته</span>
                                            break;
                                        case InviteResponse.Declined:
                                            <span class="badge text-bg-danger">رد کرده</span>
                                            break;
                                        default:
                                            <span class="badge text-bg-secondary">در انتظار پاسخ</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group" aria-label="علامت حضور">
                                        <button class="btn @(i.Attendance == AttendanceMark.Attended ? "btn-success" : "btn-outline-success")"
                                                @onclick="@(async () => await SetAttendanceAsync(i.UserId, AttendanceMark.Attended))">حاضر</button>
                                        <button class="btn @(i.Attendance == AttendanceMark.Absent ? "btn-danger" : "btn-outline-danger")"
                                                @onclick="@(async () => await SetAttendanceAsync(i.UserId, AttendanceMark.Absent))">غایب</button>
                                        @if (i.Attendance is not null)
                                        {
                                            <button class="btn btn-outline-secondary" title="پاک کردن علامت"
                                                    @onclick="@(async () => await SetAttendanceAsync(i.UserId, null))">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ===== مصوبات ===== *@
    <div class="card-panel mb-3">
        <h6 class="form-section-title"><i class="bi bi-list-check"></i>مصوبات و اقدامات</h6>

        @if (decisions is null)
        {
            <LoadingSkeleton Table="false" Rows="2" />
        }
        else if (decisions.Count == 0)
        {
            <div class="text-body-secondary small mb-2">هنوز مصوبه‌ای ثبت نشده است.</div>
        }
        else
        {
            @foreach (var d in decisions)
            {
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 py-2 border-bottom">
                    <div>
                        <div class="@(d.IsDone ? "text-decoration-line-through text-body-secondary" : "")">@d.Content</div>
                        <div class="small text-body-secondary mt-1">
                            @if (d.Assignees.Count > 0)
                            {
                                <span><i class="bi bi-person-check me-1"></i>مسئول: @string.Join("، ", d.Assignees)</span>
                            }
                            @if (d.DueAt is not null)
                            {
                                var daysLeft = (d.DueAt.Value.Date - DateTime.UtcNow).TotalDays;
                                <span class="ms-3"><i class="bi bi-calendar-deadline me-1"></i>مهلت: @d.DueAt.Value.ToPersianDate()
                                    @(daysLeft >= 0 ? $"({daysLeft:N0} روز مانده)" : "(گذشته)")
                                </span>
                            }
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" checked="@d.IsDone"
                                   @onchange="@(async e => await ToggleDecisionAsync(d.Id, (bool)e.Value!))" />
                            <label class="form-check-label small">انجام شد</label>
                        </div>
                        <button class="btn btn-sm btn-outline-danger" @onclick="@(async () => await RemoveDecisionAsync(d.Id))">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            }
        }

        @* فرم افزودن مصوبه *@
        <div class="border rounded-2 p-3 mt-3 bg-body-tertiary">
            <AppTextArea @bind-Value="newDecisionContent" Label="متن مصوبه" Rows="2"
                         Placeholder="مثال: تهیهٔ گزارش پیشرفت و ارائه تا پایان ماه" />
            <div class="row">
                <div class="col-md-4">
                    <label class="form-label">مهلت اقدام</label>
                    <PersianDateTimePicker @bind-Value="newDecisionDue" ShowTime="false" Placeholder="تاریخ مهلت (اختیاری)" />
                </div>
                <div class="col-md-8">
                    <AppTextField @bind-Value="newDecisionExternalNames" Label="مسئولین خارج از سامانه (با ویرگول)"
                                  Placeholder="مثال: واحد مالی، شرکت الف" />
                </div>
            </div>
            @if (invitees is { Count: > 0 })
            {
                <label class="form-label">مسئولین از بین مدعوین</label>
                <div class="d-flex flex-wrap gap-3 mb-2">
                    @foreach (var i in invitees)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="@("dec_" + i.UserId)"
                                   checked="@newDecisionAssignees.Contains(i.UserId)"
                                   @onchange="@(e => ToggleDecisionAssignee(i.UserId, (bool)e.Value!))" />
                            <label class="form-check-label" for="@("dec_" + i.UserId)">@i.FullName</label>
                        </div>
                    }
                </div>
            }
            <button class="btn btn-sm btn-primary" disabled="@isSavingDecision" @onclick="AddDecisionAsync">
                @if (isSavingDecision)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-plus-lg me-1"></i>
                }
                افزودن مصوبه
            </button>
            <div class="form-text mt-2">به مسئولین انتخاب‌شده از بین مدعوین، اعلان کارتابل ارسال می‌شود.</div>
        </div>
    </div>

    @* ===== صورت‌جلسه ===== *@
    <div class="card-panel">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
            <h6 class="form-section-title mb-0"><i class="bi bi-journal-text"></i>صورت‌جلسه</h6>
            <span class="small">
                @if (meeting.MinutesSentAt is not null)
                {
                    <span class="badge text-bg-success">در @(meeting.MinutesSentAt.Value.ToPersianDateTime()) به کارتابل اعضا ارسال شد</span>
                }
                else
                {
                    <span class="text-body-secondary">هنوز برای اعضا ارسال نشده است</span>
                }
            </span>
        </div>

        <RtlEditor @ref="minutesEditor" Placeholder="صورت‌جلسه را اینجا بنویسید..." MinHeight="300" />
        <div class="form-text mb-3">متن فارسی و راست‌چین؛ با نوار ابزار بالا می‌توانید متن را قالب‌بندی کنید.</div>

        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-primary" @onclick="SaveMinutes" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-save me-1"></i>
                }
                ذخیرهٔ صورت‌جلسه
            </button>
            <button class="btn btn-success" @onclick="SendMinutes" disabled="@isSending">
                @if (isSending)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-send me-1"></i>
                }
                ارسال به کارتابل اعضا
            </button>
        </div>
    </div>

    @* ===== صوت جلسه ===== *@
    <div class="card-panel mt-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
            <h6 class="form-section-title mb-0"><i class="bi bi-mic"></i>صوت جلسه</h6>
            @if (meeting.AudioUploadedAt is not null)
            {
                <span class="small text-body-secondary">
                    بارگذاری: @meeting.AudioUploadedAt.Value.ToPersianDateTime()
                    @if (meeting.AudioSizeBytes is not null)
                    {
                        <span>— @(meeting.AudioSizeBytes.Value / 1024.0 / 1024.0 < 1
                            ? $"{meeting.AudioSizeBytes.Value / 1024.0:N0} کیلوبایت"
                            : $"{meeting.AudioSizeBytes.Value / 1024.0 / 1024.0:N1} مگابایت")</span>
                    }
                </span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(meeting.AudioFileName))
        {
            <audio controls class="w-100 mb-2" preload="metadata" src="/meetings/@Id/audio"></audio>
            <div class="d-flex gap-2">
                <a href="/meetings/@Id/audio" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-download me-1"></i>دانلود فایل
                </a>
                <button class="btn btn-sm btn-outline-danger" disabled="@isAudioBusy" @onclick="RemoveAudioAsync">
                    <i class="bi bi-trash me-1"></i>حذف صوت
                </button>
            </div>
        }
        else
        {
            <InputFile accept="audio/*,.mp3,.m4a,.wav,.ogg,.aac,.wma" OnChange="UploadAudioAsync" disabled="@isAudioBusy" />
            <div class="form-text">فرمت‌های مجاز: mp3، m4a، wav، ogg، aac — حداکثر ۵۰ مگابایت. فایل جدید جای فایل قبلی را می‌گیرد (برای جایگزینی، ابتدا حذف کنید).</div>
        }
    </div>

    @* ===== عکس جلسه ===== *@
    <div class="card-panel mt-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-2">
            <h6 class="form-section-title mb-0"><i class="bi bi-image"></i>عکس جلسه</h6>
            @if (meeting.PhotoUploadedAt is not null)
            {
                <span class="small text-body-secondary">
                    بارگذاری: @meeting.PhotoUploadedAt.Value.ToPersianDateTime()
                    @if (meeting.PhotoSizeBytes is not null)
                    {
                        <span>— @(meeting.PhotoSizeBytes.Value / 1024.0 / 1024.0 < 1
                            ? $"{meeting.PhotoSizeBytes.Value / 1024.0:N0} کیلوبایت"
                            : $"{meeting.PhotoSizeBytes.Value / 1024.0 / 1024.0:N1} مگابایت")</span>
                    }
                </span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(meeting.PhotoFileName))
        {
            <img src="/meetings/@Id/photo" class="img-fluid mb-2" style="max-height: 300px; border-radius: 8px;" alt="عکس جلسه" />
            <div class="d-flex gap-2">
                <a href="/meetings/@Id/photo" class="btn btn-sm btn-outline-secondary" target="_blank">
                    <i class="bi bi-download me-1"></i>دانلود فایل
                </a>
                <button class="btn btn-sm btn-outline-danger" disabled="@isPhotoBusy" @onclick="RemovePhotoAsync">
                    <i class="bi bi-trash me-1"></i>حذف عکس
                </button>
            </div>
        }
        else
        {
            <InputFile accept="image/*,.jpg,.jpeg,.png,.gif,.bmp" OnChange="UploadPhotoAsync" disabled="@isPhotoBusy" />
            <div class="form-text">فرمت‌های مجاز: jpg، jpeg، png، gif، bmp — حداکثر ۱۰ مگابایت. فایل جدید جای فایل قبلی را می‌گیرد (برای جایگزینی، ابتدا حذف کنید).</div>
        }
    </div>
}

<AppConfirmDialog @ref="confirmDialog" />

@code {
    [Parameter] public int Id { get; set; }

    private const long MaxAudioBytes = 50 * 1024 * 1024;
    private static readonly string[] AudioExtensions = [".mp3", ".m4a", ".wav", ".ogg", ".aac", ".wma"];

    private Meeting? meeting;
    private List<InviteeInfo>? invitees;
    private List<ProposalInfo>? proposals;
    private List<DecisionInfo>? decisions;
    private string? newDecisionContent;
    private DateTime? newDecisionDue;
    private string? newDecisionExternalNames;
    private readonly HashSet<string> newDecisionAssignees = [];
    private bool isSavingDecision;
    private RtlEditor minutesEditor = default!;
    private AppConfirmDialog confirmDialog = default!;
    private bool isSaving;
    private bool isSending;
    private bool isAudioBusy;
    private bool isPhotoBusy;
    private bool loadFailed;

    private string? userId;

    private const long MaxPhotoBytes = 10 * 1024 * 1024;
    private static readonly string[] PhotoExtensions = [".jpg", ".jpeg", ".png", ".gif", ".bmp"];

    protected override async Task OnInitializedAsync()
    {
        await RunSafe(async () =>
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

            meeting = await MeetingService.GetMeetingAsync(Id);
            if (meeting is null)
            {
                loadFailed = true;
                return;
            }
            invitees = await MeetingService.GetInviteeDetailsAsync(Id);
            proposals = await MeetingService.GetProposalDetailsAsync(Id);
            decisions = await MeetingService.GetDecisionsForMeetingAsync(Id);
        });
    }

    private void ToggleDecisionAssignee(string assigneeId, bool isChecked)
    {
        if (isChecked) newDecisionAssignees.Add(assigneeId);
        else newDecisionAssignees.Remove(assigneeId);
    }

    private async Task AddDecisionAsync() => await RunSafe(async () =>
    {
        if (string.IsNullOrWhiteSpace(newDecisionContent))
        {
            Toast.ShowError("متن مصوبه را وارد کنید.");
            return;
        }

        isSavingDecision = true;
        try
        {
            await MeetingService.AddDecisionAsync(Id, newDecisionContent, newDecisionDue,
                newDecisionAssignees.ToList(), newDecisionExternalNames, userId ?? "");
            decisions = await MeetingService.GetDecisionsForMeetingAsync(Id);
            newDecisionContent = null;
            newDecisionDue = null;
            newDecisionExternalNames = null;
            newDecisionAssignees.Clear();
            Toast.ShowSuccess("مصوبه ثبت شد.");
        }
        finally
        {
            isSavingDecision = false;
        }
    }, "خطا در ثبت مصوبه.");

    private async Task RemoveDecisionAsync(int decisionId) => await RunSafe(async () =>
    {
        var confirmed = await confirmDialog.ShowAsync("حذف مصوبه", "این بند مصوبه حذف شود؟");
        if (!confirmed) return;

        await MeetingService.RemoveDecisionAsync(decisionId);
        decisions = await MeetingService.GetDecisionsForMeetingAsync(Id);
        Toast.ShowSuccess("مصوبه حذف شد.");
    });

    private async Task ToggleDecisionAsync(int decisionId, bool isDone) => await RunSafe(async () =>
    {
        await MeetingService.ToggleDecisionDoneAsync(decisionId, isDone);
        decisions = await MeetingService.GetDecisionsForMeetingAsync(Id);
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // متن موجود باید «بعد از» اولین رندر داخل ویرایشگر گذاشته شود (المان هنوز در DOM نیست اگر زودتر بزنیم)
        if (firstRender && meeting?.MinutesHtml is { Length: > 0 })
        {
            await RunSafe(async () => await minutesEditor.SetHtmlAsync(meeting.MinutesHtml));
        }
    }

    private async Task SetAttendanceAsync(string userId, AttendanceMark? mark) => await RunSafe(async () =>
    {
        await MeetingService.SetAttendanceAsync(Id, userId, mark);
        invitees = await MeetingService.GetInviteeDetailsAsync(Id);
        Toast.ShowSuccess("علامت حضور ثبت شد.");
    });

    private async Task DecideAsync(int proposalId, bool accept) => await RunSafe(async () =>
    {
        var decided = await MeetingService.DecideProposalAsync(proposalId, accept);
        if (!decided)
        {
            Toast.ShowError("این پیشنهاد قبلاً تصمیم‌گیری شده است.");
            return;
        }

        if (accept)
        {
            Toast.ShowSuccess("پیشنهاد پذیرفته شد؛ زمان جلسه جابه‌جا شد و به مدعوین اطلاع داده شد.");
        }
        else
        {
            Toast.ShowSuccess("پیشنهاد رد شد.");
        }

        meeting = await MeetingService.GetMeetingAsync(Id);
        proposals = await MeetingService.GetProposalDetailsAsync(Id);
    });

    private async Task SaveMinutes() => await RunSafe(async () =>
    {
        isSaving = true;
        try
        {
            var html = await minutesEditor.GetHtmlAsync();
            await MeetingService.SaveMinutesAsync(Id, html);
            Toast.ShowSuccess("صورت‌جلسه ذخیره شد.");
        }
        finally
        {
            isSaving = false;
        }
    }, "خطا در ذخیرهٔ صورت‌جلسه.");

    private async Task SendMinutes() => await RunSafe(async () =>
    {
        var confirmed = await confirmDialog.ShowAsync(
            "ارسال صورت‌جلسه",
            "صورت‌جلسه برای کارتابل همهٔ مدعوین ارسال شود؟",
            danger: false);
        if (!confirmed) return;

        isSending = true;
        try
        {
            var count = await MeetingService.SendMinutesAsync(Id);
            Toast.ShowSuccess($"صورت‌جلسه برای کارتابل {count} نفر ارسال شد.");
            meeting = await MeetingService.GetMeetingAsync(Id);
        }
        finally
        {
            isSending = false;
        }
    }, "خطا در ارسال صورت‌جلسه.");

    private async Task UploadAudioAsync(InputFileChangeEventArgs e) => await RunSafe(async () =>
    {
        var file = e.File;
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        if (!AudioExtensions.Contains(extension))
        {
            Toast.ShowError("فرمت فایل پشتیبانی نمی‌شود؛ فقط mp3، m4a، wav، ogg و aac.");
            return;
        }
        if (file.Size > MaxAudioBytes)
        {
            Toast.ShowError("حجم فایل بیشتر از ۵۰ مگابایت است.");
            return;
        }

        isAudioBusy = true;
        try
        {
            // ذخیره از طریق IFileStorage: نام/مسیر امن و خودکار، اعتبارسنجی پسوند و حجم
            // در همان‌جا. شناسهٔ برگشتی (نه نام فایل کاربر) در دیتابیس می‌ماند.
            await using var source = file.OpenReadStream(MaxAudioBytes);
            var storageId = await FileStorage.SaveAsync(
                Id.ToString(), Meetings.MeetingFileTypes.Audio, source, file.Name, file.ContentType);

            // فایل صوتی قبلی (در صورت وجود) حذف می‌شود
            if (!string.IsNullOrWhiteSpace(meeting?.AudioFileName))
                await FileStorage.DeleteAsync(Id.ToString(), Meetings.MeetingFileTypes.Audio, meeting.AudioFileName);

            await MeetingService.SetAudioAsync(Id, storageId, file.ContentType, file.Size, userId ?? "");
            meeting = await MeetingService.GetMeetingAsync(Id);
            Toast.ShowSuccess("صوت جلسه بارگذاری شد.");
        }
        finally
        {
            isAudioBusy = false;
        }
    }, "خطا در بارگذاری فایل صوتی.");

    private async Task RemoveAudioAsync() => await RunSafe(async () =>
    {
        var confirmed = await confirmDialog.ShowAsync("حذف صوت جلسه", "فایل صوتی جلسه حذف شود؟");
        if (!confirmed) return;

        isAudioBusy = true;
        try
        {
            var removed = await MeetingService.ClearAudioAsync(Id, userId ?? "");
            if (!string.IsNullOrWhiteSpace(removed))
                await FileStorage.DeleteAsync(Id.ToString(), Meetings.MeetingFileTypes.Audio, removed);
            meeting = await MeetingService.GetMeetingAsync(Id);
            Toast.ShowSuccess("صوت جلسه حذف شد.");
        }
        finally
        {
            isAudioBusy = false;
        }
    });



    private async Task UploadPhotoAsync(InputFileChangeEventArgs e) => await RunSafe(async () =>
    {
        var file = e.File;
        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        if (!PhotoExtensions.Contains(extension))
        {
            Toast.ShowError("فرمت فایل پشتیبانی نمی‌شود؛ فقط jpg، jpeg، png، gif و bmp.");
            return;
        }
        if (file.Size > MaxPhotoBytes)
        {
            Toast.ShowError("حجم فایل بیشتر از ۱۰ مگابایت است.");
            return;
        }

        isPhotoBusy = true;
        try
        {
            await using var source = file.OpenReadStream(MaxPhotoBytes);
            var storageId = await FileStorage.SaveAsync(
                Id.ToString(), Meetings.MeetingFileTypes.Photo, source, file.Name, file.ContentType);

            // عکس قبلی (در صورت وجود) حذف می‌شود
            if (!string.IsNullOrWhiteSpace(meeting?.PhotoFileName))
                await FileStorage.DeleteAsync(Id.ToString(), Meetings.MeetingFileTypes.Photo, meeting.PhotoFileName);

            await MeetingService.SetPhotoAsync(Id, storageId, file.ContentType, file.Size, userId ?? "");
            meeting = await MeetingService.GetMeetingAsync(Id);
            Toast.ShowSuccess("عکس جلسه بارگذاری شد.");
        }
        finally
        {
            isPhotoBusy = false;
        }
    }, "خطا در بارگذاری عکس جلسه.");

    private async Task RemovePhotoAsync() => await RunSafe(async () =>
    {
        var confirmed = await confirmDialog.ShowAsync("حذف عکس جلسه", "عکس جلسه حذف شود؟");
        if (!confirmed) return;

        isPhotoBusy = true;
        try
        {
            var removed = await MeetingService.ClearPhotoAsync(Id, userId ?? "");
            if (!string.IsNullOrWhiteSpace(removed))
                await FileStorage.DeleteAsync(Id.ToString(), Meetings.MeetingFileTypes.Photo, removed);
            meeting = await MeetingService.GetMeetingAsync(Id);
            Toast.ShowSuccess("عکس جلسه حذف شد.");
        }
        finally
        {
            isPhotoBusy = false;
        }
    });
}
