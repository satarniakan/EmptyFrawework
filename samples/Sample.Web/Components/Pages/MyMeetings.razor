@page "/my-meetings"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@inherits Platform.Web.Components.Shared.AppComponentBase
@inject IMeetingService MeetingService
@inject AuthenticationStateProvider AuthStateProvider
<PageTitle>جلسات من</PageTitle>

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">جلسات من</h3>
        <div class="text-body-secondary small">تقویم جلسات شما و دعوت‌نامه‌های در انتظار پاسخ</div>
    </div>
</div>

<MeetingCalendar Meetings="@(calendarMeetings ?? [])" />

<h6 class="form-section-title mt-3"><i class="bi bi-inbox"></i>دعوت‌نامه‌ها</h6>

@if (items is null)
{
    <LoadingSkeleton />
}
else if (items.Count == 0)
{
    <div class="text-center text-body-secondary py-5">
        <i class="bi bi-calendar2-check d-block mb-2" style="font-size: 2rem;"></i>
        فعلاً دعوت‌نامه‌ای برای جلسه‌ای ندارید.
    </div>
}
else
{
    @foreach (var item in items)
    {
        <div class="card-panel mb-3">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                <div>
                    <h6 class="mb-1 fw-semibold">@item.Meeting!.Title</h6>
                    <div class="small text-body-secondary">
                        <i class="bi bi-calendar3 me-1"></i>@item.Meeting.StartAt.ToPersianDateTime()
                        @if (item.Meeting.Kind == MeetingKind.InPerson)
                        {
                            <span class="ms-3"><i class="bi bi-geo-alt me-1"></i>حضوری — @(item.Meeting.Location ?? "نامشخص")</span>
                        }
                        else
                        {
                            <span class="ms-3"><i class="bi bi-camera-video me-1"></i>غیرحضوری —
                                <a href="@item.Meeting.MeetingLink" target="_blank" rel="noopener">لینک جلسه</a>
                            </span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(item.Meeting.Description))
                    {
                        <div class="small mt-1">@item.Meeting.Description</div>
                    }
                </div>
                <div class="d-flex flex-column align-items-end gap-1">
                    <span class="badge @ResponseBadgeClass(item.Response)">@ResponseLabel(item.Response)</span>
                    @if (item.Attendance == AttendanceMark.Attended)
                    {
                        <span class="badge text-bg-success">حاضر بودید</span>
                    }
                    else if (item.Attendance == AttendanceMark.Absent)
                    {
                        <span class="badge text-bg-danger">غایب</span>
                    }
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mt-3">
                @if (item.Response != InviteResponse.Accepted)
                {
                    <button class="btn btn-sm btn-success" disabled="@isBusy"
                            @onclick="@(async () => await RespondAsync(item, InviteResponse.Accepted))">
                        <i class="bi bi-check-lg me-1"></i>پذیرش دعوت
                    </button>
                }
                @if (item.Response != InviteResponse.Declined)
                {
                    <button class="btn btn-sm btn-outline-danger" disabled="@isBusy"
                            @onclick="@(async () => await RespondAsync(item, InviteResponse.Declined))">
                        <i class="bi bi-x-lg me-1"></i>رد دعوت
                    </button>
                }
                <button class="btn btn-sm btn-outline-primary" @onclick="@(async () => await ToggleProposalPanelAsync(item))">
                    <i class="bi bi-clock-history me-1"></i>پیشنهاد زمان جدید
                </button>
                @if (item.Meeting.MinutesSentAt is not null)
                {
                    <a href="/my-meetings/@item.MeetingId" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-journal-text me-1"></i>مشاهده صورت‌جلسه
                    </a>
                }
            </div>

            @if (openPanelInviteeId == item.Id)
            {
                <div class="border rounded-2 p-3 mt-3 bg-body-tertiary">
                    <label class="form-label">زمان پیشنهادی شما</label>
                    <PersianDateTimePicker @bind-Value="proposalTime" ShowTime="true"
                                           Placeholder="تاریخ و ساعت پیشنهادی را انتخاب کنید" />
                    <AppTextArea @bind-Value="proposalNote" Label="توضیح (اختیاری)" Rows="2"
                                 Placeholder="مثلاً: در آن بازه در جلسهٔ دیگری هستم" />
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-primary" disabled="@isBusy" @onclick="@(async () => await SubmitProposalAsync(item))">
                            ثبت پیشنهاد
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="@(async () => openPanelInviteeId = null)">انصراف</button>
                    </div>
                    <div class="form-text mt-2">پیشنهاد شما برای تصمیم‌گیری به مسئول جلسه ارسال می‌شود و نتیجه در کارتابل شما اعلام می‌گردد.</div>
                </div>
            }
        </div>
    }
}

@code {
    private List<InviteRow>? items;
    private List<Meeting>? calendarMeetings;
    private int? openPanelInviteeId;
    private DateTime proposalTime = DateTime.UtcNow.AddDays(1);
    private string? proposalNote;
    private bool isBusy;

    private string? userId;

    protected override async Task OnInitializedAsync() => await RunSafe(async () =>
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (userId is null) return;

        calendarMeetings = await MeetingService.GetCalendarMeetingsAsync(userId);
        var invites = await MeetingService.GetInvitesForUserAsync(userId);
        items = invites.Select(i => new InviteRow(i)).ToList();
    });

    private async Task RespondAsync(InviteRow row, InviteResponse response) => await RunSafe(async () =>
    {
        isBusy = true;
        try
        {
            if (await MeetingService.RespondAsync(row.Invite.MeetingId, userId ?? "", response))
            {
                row.Invite.Response = response;
                row.Invite.RespondedAt = DateTime.UtcNow;
                Toast.ShowSuccess(response == InviteResponse.Accepted ? "پذیرش شما ثبت شد." : "رد دعوت ثبت شد.");
            }
        }
        finally
        {
            isBusy = false;
        }
    });

    private async Task ToggleProposalPanelAsync(InviteRow row)
    {
        if (openPanelInviteeId == row.Id)
        {
            openPanelInviteeId = null;
            return;
        }
        openPanelInviteeId = row.Id;
        proposalTime = DateTime.UtcNow.AddDays(1);
        proposalNote = null;
        await Task.CompletedTask;
    }

    private async Task SubmitProposalAsync(InviteRow row) => await RunSafe(async () =>
    {
        if (proposalTime <= DateTime.UtcNow)
        {
            Toast.ShowError("زمان پیشنهادی باید در آینده باشد.");
            return;
        }

        isBusy = true;
        try
        {
            if (await MeetingService.ProposeNewTimeAsync(row.Invite.MeetingId, userId ?? "", proposalTime, proposalNote))
            {
                Toast.ShowSuccess("پیشنهاد زمان شما ثبت شد و برای تصمیم‌گیری ارسال گردید.");
                openPanelInviteeId = null;
            }
        }
        finally
        {
            isBusy = false;
        }
    });

    private static string ResponseLabel(InviteResponse response) => response switch
    {
        InviteResponse.Accepted => "پذیرفته‌اید",
        InviteResponse.Declined => "رد کرده‌اید",
        _ => "در انتظار پاسخ شما"
    };

    private static string ResponseBadgeClass(InviteResponse response) => response switch
    {
        InviteResponse.Accepted => "text-bg-success",
        InviteResponse.Declined => "text-bg-danger",
        _ => "text-bg-warning"
    };

    private sealed class InviteRow(MeetingInvitee invite)
    {
        public MeetingInvitee Invite { get; } = invite;
        public int Id => Invite.Id;
        public int MeetingId => Invite.MeetingId;
        public Meeting Meeting => Invite.Meeting!;
        public InviteResponse Response { get => Invite.Response; set => Invite.Response = value; }
        public DateTime? RespondedAt { get => Invite.RespondedAt; set => Invite.RespondedAt = value; }
        public AttendanceMark? Attendance { get => Invite.Attendance; set => Invite.Attendance = value; }
    }
}
