@page "/meetings"
@rendermode InteractiveServer
@attribute [Authorize(Policy = Meetings.MeetingPermissions.Manage)]
@using Microsoft.AspNetCore.Authorization
@inherits Platform.Web.Components.Shared.AppComponentBase
@inject IMeetingService MeetingService
<PageTitle>مدیریت جلسات</PageTitle>

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">مدیریت جلسات</h3>
        <div class="text-body-secondary small">تعریف جلسهٔ جدید، مدیریت حضور و غیاب و صورت‌جلسه</div>
    </div>
    <a href="/meetings/new" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>جلسهٔ جدید
    </a>
</div>

<div class="card-panel">
    @if (meetings is null)
    {
        <LoadingSkeleton />
    }
    else if (meetings.Count == 0)
    {
        <div class="text-center text-body-secondary py-5">
            <i class="bi bi-calendar2-week d-block mb-2" style="font-size: 2rem;"></i>
            هنوز جلسه‌ای تعریف نشده است.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>موضوع</th>
                        <th>زمان</th>
                        <th>نوع برگزاری</th>
                        <th>مدعوین</th>
                        <th>صورت‌جلسه</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in meetings)
                    {
                        <tr>
                            <td class="fw-semibold">@m.Title</td>
                            <td class="text-nowrap">@m.StartAt.ToPersianDateTime()</td>
                            <td>
                                @if (m.Kind == MeetingKind.InPerson)
                                {
                                    <span class="badge text-bg-info">حضوری</span>
                                    <span class="small text-body-secondary">@m.Location</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">غیرحضوری</span>
                                }
                            </td>
                            <td>
                                <span class="small">
                                    @(m.Invitees.Count(i => i.Response == InviteResponse.Accepted)) پذیرفته،
                                    @(m.Invitees.Count(i => i.Response == InviteResponse.Declined)) رد شده،
                                    @(m.Invitees.Count(i => i.Response == InviteResponse.Pending)) در انتظار
                                </span>
                            </td>
                            <td>
                                @if (m.MinutesSentAt is not null)
                                {
                                    <span class="badge text-bg-success">ارسال شده</span>
                                }
                                else if (!string.IsNullOrWhiteSpace(m.MinutesHtml))
                                {
                                    <span class="badge text-bg-warning">نوشته شده</span>
                                }
                                else
                                {
                                    <span class="text-body-secondary small">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <a href="/meetings/@m.Id/manage" class="btn btn-sm btn-outline-primary">مدیریت جلسه</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<Meeting>? meetings;

    protected override Task OnInitializedAsync() => RunSafe(async () =>
    {
        meetings = await MeetingService.GetAllMeetingsAsync();
    });
}
