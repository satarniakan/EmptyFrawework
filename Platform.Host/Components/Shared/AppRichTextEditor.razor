@* Platform.Host/Components/Shared/AppRichTextEditor.razor *@
@* ویرایشگر غنی Jodit (RTL/فارسی) با همگام‌سازی دوطرفهٔ Value؛ جایگزین AppTextArea برای متن بلندِ محتوایی. *@
@* در SSR استاتیک یک textarea ساده نمایش می‌دهد؛ Jodit فقط در حالت تعاملی بارگذاری می‌شود. *@
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="@WrapperClass">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="form-label" for="@_id">@Label @if (IsRequired) { <span class="text-danger" title="الزامی">*</span> }</label>
    }

    <textarea id="@_id" class="@CssClass" value="@Value" placeholder="@Placeholder" disabled="@Disabled" rows="@Rows"></textarea>

    @if (CascadedEditContext is not null && ValueExpression is not null)
    {
        <ValidationMessage For="@ValueExpression" class="text-danger small mt-1 d-block" />
    }
    @if (!string.IsNullOrEmpty(Hint))
    {
        <div class="form-text">@Hint</div>
    }
</div>

@code {
    [CascadingParameter]
    private EditContext? CascadedEditContext { get; set; }

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string WrapperClass { get; set; } = "mb-3";
    [Parameter] public string CssClass { get; set; } = "form-control";
    [Parameter] public int Height { get; set; } = 300;
    [Parameter] public int Rows { get; set; } = 4;
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string?>>? ValueExpression { get; set; }

    private readonly string _id = $"jodit-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<AppRichTextEditor>? _selfRef;
    private string? _lastKnown;
    private bool _lastDisabled;
    private FieldIdentifier _fieldIdentifier;

    private bool IsRequired => Required || ValidationAttributeInspector.IsRequired(ValueExpression);

    protected override void OnInitialized()
    {
        _lastKnown = Value;
        _lastDisabled = Disabled;
        if (ValueExpression is not null)
            _fieldIdentifier = FieldIdentifier.Create(ValueExpression);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || RendererInfo.Name == "Static") return;

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "/jodit-interop.js");
        _selfRef = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("init", _id, _selfRef, new
        {
            height = Height,
            placeholder = Placeholder,
            disabled = Disabled
        });
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_module is null) return;

        if (!string.Equals(Value, _lastKnown, StringComparison.Ordinal))
        {
            _lastKnown = Value;
            await _module.InvokeVoidAsync("setValue", _id, Value);
        }
        if (Disabled != _lastDisabled)
        {
            _lastDisabled = Disabled;
            await _module.InvokeVoidAsync("setDisabled", _id, Disabled);
        }
    }

    [JSInvokable]
    public async Task OnEditorChanged(string? html)
    {
        _lastKnown = html;
        if (CascadedEditContext is not null && ValueExpression is not null)
            CascadedEditContext.NotifyFieldChanged(_fieldIdentifier);
        await ValueChanged.InvokeAsync(html);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.InvokeVoidAsync("destroy", _id); } catch (JSException) { }
            await _module.DisposeAsync();
        }
        _selfRef?.Dispose();
    }
}