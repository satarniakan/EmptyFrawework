@* دکمهٔ فعال‌سازی اعلان‌های مرورگر (وب‌پوش). اگر VAPID تنظیم نشده باشد، خودش را پنهان می‌کند. *@
@* کلید عمومی با fetch از endpoint سبک خوانده می‌شود (نه از سرویس مدار) تا هم‌روندی
   DbContext با صفحهٔ میزبان پیش نیاید — همان الگوی NotificationBell. *@
@using Microsoft.JSInterop
@inject IJSRuntime JS

@if (!string.IsNullOrWhiteSpace(publicKey))
{
    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-sm btn-outline-secondary" @onclick="SubscribeAsync" disabled="@busy">
            <i class="bi bi-bell me-1"></i>فعال‌سازی اعلان‌های مرورگر
        </button>
        @if (statusMessage is not null)
        {
            <span class="small @(subscribed ? "text-success" : "text-body-secondary")">@statusMessage</span>
        }
    </div>
}

@code {
    private string? publicKey;
    private bool busy;
    private bool subscribed;
    private string? statusMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || RendererInfo.Name == "Static") return;

        // خواندن کلید با fetch (خارج از DbContext مدار). اگر شکست خورد، دکمه پنهان
        // می‌ماند ولی صفحه نباید خطای رندر بدهد — پس بی‌صدا نادیده می‌گیریم.
        try
        {
            var info = await JS.InvokeAsync<PublicKeyDto>("platformApi.get", "/api/v1/push/public-key");
            publicKey = info?.Enabled == true ? info.PublicKey : null;
            await InvokeAsync(StateHasChanged);
        }
        catch (JSException)
        {
            // مرورگر از fetch پشتیبانی نمی‌کند یا JS هنوز آماده نیست — بی‌صدا رد شو.
        }
    }

    private async Task SubscribeAsync()
    {
        busy = true;
        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>(
                "import", "/_content/Platform.Web/push-subscribe.js");
            await using (module)
            {
                var result = await module.InvokeAsync<PushSubscribeResult>("subscribePush",
                    "/_content/Platform.Web/push-sw.js", publicKey, "/api/v1/push/subscriptions");

                if (result?.Ok == true)
                {
                    subscribed = true;
                    statusMessage = "اعلان‌های مرورگر فعال شد.";
                }
                else
                {
                    statusMessage = result?.Reason == "denied"
                        ? "دسترسی اعلان در مرورگر بسته است؛ از تنظیمات سایت بازش کنید."
                        : "مرورگر شما اعلان وب را پشتیبانی نمی‌کند.";
                }
            }
        }
        catch (Exception)
        {
            statusMessage = "فعال‌سازی ناموفق بود؛ دوباره تلاش کنید.";
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class PushSubscribeResult
    {
        public bool Ok { get; set; }
        public string? Reason { get; set; }
    }

    private sealed class PublicKeyDto
    {
        public string? PublicKey { get; set; }
        public bool Enabled { get; set; }
    }
}
