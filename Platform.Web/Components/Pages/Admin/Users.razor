@* Platform.Web/Components/Pages/Admin/Users.razor *@
@page "/admin/users"
@rendermode InteractiveServer
@attribute [Authorize(Roles = Platform.Domain.Identity.Roles.Admin)]
@using Microsoft.AspNetCore.Authorization
@using Platform.Application.Services
@using Platform.Application.DTOs
<PageTitle>مدیریت کاربران</PageTitle>


@if (Success is not null)
{
    <div class="alert alert-success">نقش کاربر با موفقیت به‌روزرسانی شد.</div>
}
<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
    <div>
        <h3 class="mb-1">مدیریت کاربران و نقش‌ها</h3>
        <div class="text-body-secondary small">فهرست افراد سامانه؛ درج، ویرایش، حذف و نقش‌ها</div>
    </div>
    <a href="/admin/users/add" class="btn btn-primary btn-sm">افزودن کاربر جدید</a>
</div>
<div class="card-panel mb-3">
    <div class="d-flex gap-2">
        <input class="form-control form-control-sm" placeholder="جست‌وجو: شماره، نام یا ایمیل…"
               @bind="search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
        <button class="btn btn-sm btn-outline-secondary" @onclick="SearchAsync">جست‌وجو</button>
        <label class="btn btn-sm btn-outline-secondary mb-0" title="ستون‌ها: شماره موبایل، نام، ایمیل (اختیاری)، رمز (اختیاری)">
            <i class="bi bi-file-earmark-excel me-1"></i>ایمپورت از اکسل
            <InputFile accept=".xlsx" OnChange="ImportAsync" style="display:none;" />
        </label>
    </div>
    @if (!string.IsNullOrEmpty(importSummary))
    {
        <div class="alert alert-success small py-2 mt-2 mb-0">@importSummary</div>
    }
    @if (importErrors.Count > 0)
    {
        <div class="alert alert-warning small py-2 mt-2 mb-0">
            <ul class="mb-0 ps-3">
                @foreach (var error in importErrors.Take(10))
                {
                    <li>سطر @error.RowNumber (@error.Column): @error.Message</li>
                }
                @if (importErrors.Count > 10)
                {
                    <li>و @(importErrors.Count - 10) خطای دیگر…</li>
                }
            </ul>
        </div>
    }
</div>
<div class="card-panel">
    @if (page is null)
    {
        <LoadingSkeleton />
    }
    else if (!page.Items.Any())
    {
        <div class="text-center text-body-secondary py-4">
            <i class="bi bi-people fs-3 d-block mb-2"></i>
            <span class="small">کاربری یافت نشد.</span>
        </div>
    }
    else
    {
        <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>شماره موبایل</th>
                    <th>نام کامل</th>
                    <th>ایمیل</th>
                    <th>نقش فعلی</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in page.Items)
                {
                    <tr>
                        <td>@u.PhoneNumber</td>
                        <td>@u.FullName</td>
                        <td>@u.Email</td>
                        <td>
                            @if (u.Roles.Any())
                            {
                                @string.Join("، ", u.Roles.Select(r => Platform.Domain.Identity.Roles.ToPersian(r)))
                            }
                            else
                            {
                                <span class="text-body-secondary">بدون نقش</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a href="/admin/users/@u.UserId" class="btn btn-sm btn-outline-primary">تغییر نقش</a>
                                <a href="/admin/users/@u.UserId/edit" class="btn btn-sm btn-outline-secondary">ویرایش</a>
                                @if (impersonationEnabled && u.UserId != currentUserId)
                                {
                                    <form action="/admin/impersonate" method="post" data-enhance="false" class="d-inline">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="userId" value="@u.UserId" />
                                        <button type="submit" class="btn btn-sm btn-outline-warning"
                                                title="ورود به‌جای این کاربر (ثبت می‌شود)">
                                            جانشینی
                                        </button>
                                    </form>
                                }
                                <button class="btn btn-sm btn-outline-danger" disabled="@(u.UserId == currentUserId)"
                                        @onclick="@(async () => await AskDelete(u))">حذف</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <Pager CurrentPage="page.Page" TotalPages="page.TotalPages" TotalCount="page.TotalCount"
               OnPageChanged="GoToPage" />
    }
</div>

<AppConfirmDialog @ref="confirmDialog" />

@code {
    [SupplyParameterFromQuery(Name = "success")]
    private string? Success { get; set; }

    private PagedResult<UserListItemDto>? page;
    private string? search;
    private int currentPage = 1;
    private const int PageSize = 20;
    private string? currentUserId;
    private bool impersonationEnabled;
    private string? importSummary;
    private List<Platform.Application.Imports.ImportRowError> importErrors = new();
    private AppConfirmDialog confirmDialog = default!;

    [Inject] private IUserAdminService UserAdminService { get; set; } = default!;
    [Inject] private IUserImportService UserImportService { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] private Platform.Web.Services.ToastService ToastService { get; set; } = default!;
    [Inject] private IConfiguration Configuration { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        impersonationEnabled = Configuration.GetValue("Support:ImpersonationEnabled", false);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        page = await UserAdminService.GetUsersPagedAsync(search, currentPage, PageSize);
    }

    private async Task GoToPage(int newPage)
    {
        currentPage = newPage;
        await LoadAsync();
    }

    private async Task SearchAsync()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SearchAsync();
    }

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        importSummary = null;
        importErrors = new();

        try
        {
            await using var source = e.File.OpenReadStream(5 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await source.CopyToAsync(buffer);
            buffer.Position = 0;

            var result = await UserImportService.ImportAsync(buffer);
            importSummary = $"{result.ImportedCount} کاربر از {result.TotalRows} سطر وارد شد.";
            importErrors = result.RowErrors;
            if (result.ImportedCount > 0)
            {
                currentPage = 1;
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError(Platform.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex));
        }
    }

    private async Task AskDelete(UserListItemDto user)
    {
        var confirmed = await confirmDialog.ShowAsync(
            "حذف کاربر",
            $"کاربر «{(string.IsNullOrWhiteSpace(user.FullName) ? user.PhoneNumber : user.FullName)}» برای همیشه حذف شود؟ این عملیات بازگشت‌پذیر نیست.");
        if (!confirmed) return;

        var result = await UserAdminService.DeleteUserAsync(user.UserId, currentUserId ?? string.Empty);
        if (result.Succeeded)
        {
            ToastService.ShowSuccess("کاربر حذف شد.");
            await LoadAsync();
        }
        else
        {
            ToastService.ShowError(string.Join("، ", result.Errors.Select(e => e.Description)));
        }
    }
}