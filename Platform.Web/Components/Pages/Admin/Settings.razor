@* Platform.Web/Components/Pages/Admin/Settings.razor *@
@page "/admin/settings"
@rendermode InteractiveServer
@attribute [Authorize(Roles = Platform.Domain.Identity.Roles.Admin)]
@using Microsoft.AspNetCore.Authorization
@using Platform.Application.Services
@using Platform.Domain.Identity
<PageTitle>تنظیمات سامانه</PageTitle>

<div class="mb-3">
    <h3 class="mb-1">تنظیمات سامانه و اتصال‌ها</h3>
    <div class="text-body-secondary small">
        نام سایت، قالب پیام‌ها و همهٔ مقادیر اتصال (کاوه‌نگار، SMTP، زرین‌پال، کپچا، وب‌پوش) —
        بدون نیاز به تغییر کد و استقرار دوباره.
        ترتیب مقدار مؤثر: <b>همین صفحه</b> ← <code>appsettings.json</code> ← پیش‌فرض.
        انتخابِ درگاه (کدام provider) در <code>appsettings</code> می‌ماند.
    </div>
</div>

<div class="alert alert-warning small">
    <i class="bi bi-shield-lock me-1"></i>
    مقادیر محرمانه (کلید API، رمز) <b>رمزنگاری‌شده</b> ذخیره می‌شوند و هرگز نمایش داده نمی‌شوند —
    فقط با نوشتن مقدار جدید عوض می‌شوند. دکمهٔ «بازگشت» ردیف را حذف می‌کند تا مقدار از <code>appsettings</code> خوانده شود.
</div>

@if (groups is null)
{
    <div class="card-panel"><LoadingSkeleton /></div>
}
else
{
    @foreach (var group in groups)
    {
        <div class="card-panel mb-3">
            <h5 class="mb-3">@group.Name</h5>
            @foreach (var row in group.Rows)
            {
                <div class="mb-3">
                    <label class="form-label">
                        @row.Descriptor.Title
                        @if (row.Descriptor.IsSecret)
                        {
                            <span class="badge text-bg-warning ms-1">محرمانه</span>
                        }
                        @if (row.HasDbValue)
                        {
                            <span class="badge text-bg-success ms-1">تنظیم‌شده اینجا</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary ms-1">از appsettings/پیش‌فرض</span>
                        }
                    </label>
                    <div class="input-group">
                        @if (row.Descriptor.IsSecret)
                        {
                            <input type="@(row.Reveal ? "text" : "password")" class="form-control" dir="ltr"
                                   placeholder="@(row.HasDbValue ? "••• ذخیره شده — برای تغییر، مقدار جدید بنویسید" : "خالی = appsettings")"
                                   value="@row.Value" @onchange="(e) => row.Value = e.Value?.ToString()" />
                            <button class="btn btn-outline-secondary" title="نمایش/پنهان"
                                    @onclick="() => row.Reveal = !row.Reveal">
                                <i class="bi @(row.Reveal ? "bi-eye-slash" : "bi-eye")"></i>
                            </button>
                        }
                        else
                        {
                            <input class="form-control" dir="auto"
                                   placeholder="@(string.IsNullOrEmpty(row.Descriptor.DefaultValue) ? "خالی = appsettings" : $"پیش‌فرض: {row.Descriptor.DefaultValue}")"
                                   value="@row.Value" @onchange="(e) => row.Value = e.Value?.ToString()" />
                        }
                        <button class="btn btn-outline-primary" @onclick="() => SaveAsync(row)"
                                disabled="@row.Saving">
                            @(row.Saving ? "…" : "ذخیره")
                        </button>
                        @if (row.HasDbValue)
                        {
                            <button class="btn btn-outline-secondary" title="حذف و بازگشت به appsettings"
                                    @onclick="() => ClearAsync(row)" disabled="@row.Saving">
                                بازگشت
                            </button>
                        }
                    </div>
                    <div class="form-text">کلید: <code dir="ltr">@row.Descriptor.Key</code></div>
                </div>
            }
        </div>
    }
}

@code {
    private List<SettingGroup>? groups;

    [Inject] private ISettingCatalog Catalog { get; set; } = default!;
    [Inject] private ISettingService SettingService { get; set; } = default!;
    [Inject] private Platform.Web.Services.ToastService Toast { get; set; } = default!;

    private sealed class SettingRow
    {
        public SettingDescriptor Descriptor { get; set; } = default!;
        public string? Value { get; set; }
        public bool HasDbValue { get; set; }
        public bool Reveal { get; set; }
        public bool Saving { get; set; }
    }

    private sealed class SettingGroup
    {
        public string Name { get; set; } = string.Empty;
        public List<SettingRow> Rows { get; set; } = new();
    }

    protected override async Task OnInitializedAsync()
    {
        var loaded = new List<SettingGroup>();
        foreach (var descriptor in Catalog.All)
        {
            var group = loaded.FirstOrDefault(g => g.Name == descriptor.Group);
            if (group is null)
            {
                group = new SettingGroup { Name = descriptor.Group };
                loaded.Add(group);
            }

            // secret هرگز پیش‌پر نمی‌شود؛ بقیه مقدار مؤثر را نشان می‌دهند
            var hasDbValue = await SettingService.HasValueAsync(descriptor.Key);
            group.Rows.Add(new SettingRow
            {
                Descriptor = descriptor,
                HasDbValue = hasDbValue,
                Value = descriptor.IsSecret ? null : await SettingService.GetAsync(descriptor.Key)
            });
        }

        groups = loaded;
    }

    private async Task SaveAsync(SettingRow row)
    {
        // secret خالی یعنی «دست نزن» — وگرنه ردیف با مقدار خالی رونویسی می‌شد
        if (row.Descriptor.IsSecret && string.IsNullOrWhiteSpace(row.Value))
        {
            Toast.ShowError("برای تغییر مقدار محرمانه، مقدار جدید را بنویسید.");
            return;
        }

        row.Saving = true;
        try
        {
            await SettingService.SetAsync(row.Descriptor.Key, row.Value);
            row.HasDbValue = await SettingService.HasValueAsync(row.Descriptor.Key);
            if (row.Descriptor.IsSecret)
                row.Value = null; // مقدار خام در حافظه صفحه نماند
            Toast.ShowSuccess("تنظیم ذخیره شد.");
        }
        catch (Exception ex)
        {
            Toast.ShowError(Platform.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex));
        }
        finally
        {
            row.Saving = false;
        }
    }

    private async Task ClearAsync(SettingRow row)
    {
        row.Saving = true;
        try
        {
            await SettingService.ClearAsync(row.Descriptor.Key);
            row.HasDbValue = false;
            row.Value = row.Descriptor.IsSecret ? null : await SettingService.GetAsync(row.Descriptor.Key);
            Toast.ShowSuccess("به مقدار appsettings/پیش‌فرض برگشت.");
        }
        catch (Exception ex)
        {
            Toast.ShowError(Platform.Web.Components.Shared.ErrorMessageHelper.ToUserMessage(ex));
        }
        finally
        {
            row.Saving = false;
        }
    }
}
