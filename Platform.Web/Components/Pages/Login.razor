@page "/login"
@attribute [ExcludeFromInteractiveRouting]
<PageTitle>ورود</PageTitle>

<div class="d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="card-panel" style="width: 100%; max-width: 420px;">
        <h3 class="text-center mb-2">ورود</h3>
        <p class="text-center text-muted mb-4" style="font-size: 0.9rem;">
            شماره موبایل خود را وارد کنید تا کد ورود برایتان پیامک شود.
        </p>

        @if (Error is not null)
        {
            <div class="alert alert-danger">@(Error == "captcha" ? "اعتبارسنجی امنیتی ناموفق بود؛ دوباره تلاش کنید." : "شماره موبایل معتبر نیست.")</div>
        }

        <form method="post" action="/Account/RequestOtp" data-enhance="false">
            <AntiforgeryToken />

            <div class="mb-4">
                <label class="form-label">شماره موبایل</label>
                <input type="tel" name="phoneNumber" class="form-control" placeholder="09xxxxxxxxx" required pattern="09[0-9]{9}" />
            </div>

            @if (!string.IsNullOrWhiteSpace(turnstileSiteKey))
            {
                @* کپچا فقط وقتی SiteKey تنظیم شده رندر می‌شود؛ در غیر این صورت endpoint بدون کپچا کار می‌کند *@
                <div class="mb-4">
                    <div class="cf-turnstile" data-sitekey="@turnstileSiteKey" data-language="fa"></div>
                </div>
                <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
            }

            <button type="submit" class="btn btn-primary w-100">ارسال کد ورود</button>
        </form>

        <p class="text-center text-muted mt-3 mb-0" style="font-size: 0.9rem;">
            <a href="/login-password">ورود از طریق نام کاربری و رمز عبور</a>
        </p>

        @if (showDevLogin)
        {
            <a href="/dev-login" class="btn btn-outline-secondary w-100 mt-2" data-enhance="false">
                <i class="bi bi-lightning-charge me-1"></i>ورود مستقیم ادمین (حالت توسعه)
            </a>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    [Inject] private IConfiguration Configuration { get; set; } = default!;
    [Inject] private IWebHostEnvironment Environment { get; set; } = default!;

    private bool showDevLogin =>
        Environment.IsDevelopment() &&
        !string.IsNullOrWhiteSpace(Configuration["Dev:AutoLoginPhone"]);

    private string? turnstileSiteKey => Configuration["Captcha:Turnstile:SiteKey"];
}
