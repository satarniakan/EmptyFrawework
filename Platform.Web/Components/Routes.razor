@*
    روتر مشترک. چون این کامپوننت در کتابخانهٔ Platform.Web است، مونتاژ خودش همیشه
    در جست‌وجو لحاظ می‌شود؛ صفحاتی که در پروژهٔ میزبان تعریف شده‌اند از راه
    AdditionalAssemblies اضافه می‌شوند. (در پروژهٔ میزبان به این شکل استفاده کنید:
    <Routes AdditionalAssemblies="@new[] { typeof(MyPage).Assembly }" /> )
*@
<Router AppAssembly="@typeof(Routes).Assembly"
        AdditionalAssemblies="@AdditionalAssemblies">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                <LayoutView Layout="@typeof(MainLayout)">
                    <p class="text-danger">شما دسترسی لازم برای مشاهده این صفحه را ندارید.</p>
                </LayoutView>
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <Platform.Web.Components.Pages.NotFound />
        </LayoutView>
    </NotFound>
</Router>

@code {
    /// <summary>مونتاژهای اضافیِ حاوی صفحات (مثلاً مونتاژ پروژهٔ میزبان).</summary>
    [Parameter]
    public IEnumerable<System.Reflection.Assembly>? AdditionalAssemblies { get; set; }
}