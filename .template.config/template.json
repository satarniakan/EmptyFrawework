{
  "$schema": "http://json.schemastore.org/template",
  "author": "satarniakan",
  "classifications": ["Web", "Blazor", "Blazor Server"],
  "name": "Empty Platform (Persian RTL Blazor)",
  "description": "Reusable Persian RTL Blazor Server platform: Identity + OTP login, users and roles, permission-gated data-driven menu, audit log, notifications, outbox, Persian helpers and Excel/PDF exports. Domain ships only as a Sample module.",
  "groupIdentity": "EmptyFrawework.Platform",
  "precedence": "100",
  "identity": "EmptyFrawework.Platform.Blazor",
  "shortName": "empty-platform",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "Platform",
  "preferNameDirectory": true,
  "guids": [
    "3f6d1c2a-0000-4000-8000-000000000001"
  ],
  "symbols": {
    "SampleName": {
      "type": "parameter",
      "description": "Name of the sample domain module shipped as the wiring example (rename or delete it in your project).",
      "datatype": "string",
      "defaultValue": "Sample",
      "replaces": "Sample",
      "fileRename": "Sample"
    }
  },
  "sources": [
    {
      "exclude": [
        ".git/**",
        ".vs/**",
        ".idea/**",
        "**/bin/**",
        "**/obj/**",
        ".template.config/**",
        "artifacts/**",
        "TestResults/**",
        "content/**",
        "DataProtection-Keys/**",
        "samples/*/appsettings.json",
        "samples/*/appsettings.Development.json",
        "push.out.log",
        "push.err.log"
      ]
    }
  ]
}