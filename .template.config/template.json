{
  "$schema": "http://json.schemastore.org/template",
  "author": "satarniakan",
  "classifications": ["Web", "Blazor", "Blazor Server"],
  "name": "Empty Platform (Persian RTL Blazor)",
  "description": "Reusable Persian RTL Blazor Server platform: Identity + OTP login, users and roles, permission-gated data-driven menu, audit log, notifications, outbox, API tokens, payments, Persian helpers and Excel/PDF import/export. Ships with an empty host; add your domain module without editing the base.",
  "groupIdentity": "EmptyFrawework.Platform",
  "precedence": "100",
  "identity": "EmptyFrawework.Platform.Blazor",
  "shortName": "empty-platform",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "Platform",
  "preferNameDirectory": true,
  "guids": [
    "3f6d1c2a-0000-4000-8000-000000000001"
  ],
  "sources": [
    {
      "exclude": [
        ".git/**",
        ".vs/**",
        ".idea/**",
        "**/bin/**",
        "**/obj/**",
        ".template.config/**",
        "artifacts/**",
        "TestResults/**",
        "content/**",
        "DataProtection-Keys/**",
        "Platform.App/appsettings.json",
        "Platform.App/appsettings.Development.json",
        "push.out.log",
        "push.err.log"
      ]
    }
  ]
}