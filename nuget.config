<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- با مدیریت متمرکز نسخه‌ها، وجود چند منبع بدون نگاشت هشدار NU1507 می‌دهد.
       همهٔ بسته‌های این مخزن عمومی‌اند و از nuget.org گرفته می‌شوند. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>