<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- بسته‌های پایه (Platform.*) از فید محلی artifacts/packages خوانده می‌شوند؛
       بقیهٔ بسته‌ها از nuget.org. با مدیریت متمرکز نسخه، نگاشت منبع الزامی است. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="platform-local" value="artifacts/packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="platform-local">
      <package pattern="Platform.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>